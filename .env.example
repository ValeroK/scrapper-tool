# scrapper-tool — environment variables (example)
#
# Copy to .env and edit. Every variable below is OPTIONAL — the library
# has working defaults for "ultimate scraper" use. Override only what you
# need. Full reference: docs/SETTINGS.md
#
# Loading: scrapper-tool itself does NOT load .env automatically. Either:
#   1. export the vars in your shell,
#   2. use `uv run --env-file .env ...` / `docker compose up`,
#   3. or load .env in your own entry point (python-dotenv, etc).

# =============================================================================
# Pattern E — LLM-agent layer (v0.3.0+)
# =============================================================================

# --- Browser backend ---------------------------------------------------------
# Choices: camoufox (default — 0% headless detection, ~200 MB RAM/instance,
#                    ~42 s/bypass — best for protected sites)
#          patchright (~67% detection reduction, faster, lower RAM —
#                      good for unprotected/lightly-protected sites)
#          scrapling (reuses [hostile] extra)
#          obscura (EXPERIMENTAL — lightweight Rust CDP-server browser,
#                   ~30 MB RAM. Requires a running `obscura serve` sidecar;
#                   set SCRAPPER_TOOL_AGENT_OBSCURA_CDP_URL below. Benchmark
#                   its detection rate before trusting on protected sites.)
# NOTE: zendriver / botasaurus were removed in v1.5.0 — they returned no
# Playwright browser and raised at browse time. Obscura fills that niche.
SCRAPPER_TOOL_AGENT_BROWSER=camoufox
# CDP WebSocket endpoint for the Obscura backend (only used when
# SCRAPPER_TOOL_AGENT_BROWSER=obscura). Default: http://127.0.0.1:9222
# SCRAPPER_TOOL_AGENT_OBSCURA_CDP_URL=http://127.0.0.1:9222

# Per-session fingerprint generator (UA / canvas / WebGL / audio / fonts).
# Choices: browserforge (default; ignored by Camoufox which has its own)
#          none
SCRAPPER_TOOL_AGENT_FINGERPRINT=browserforge

# Behavior shaping for input timing (defeats DataDome behavioral detection).
# Choices: humanlike (default; jittered keystrokes, bezier mouse paths)
#          fast (skip delays — for unprotected sites)
#          off (no shaping at all)
SCRAPPER_TOOL_AGENT_BEHAVIOR=humanlike

# Run with a visible browser window (useful for debugging).
SCRAPPER_TOOL_AGENT_HEADFUL=0

# Optional outbound proxy (HTTP/SOCKS) passed through to the browser.
# Format: "http://user:pass@host:port" or "socks5://host:port"
# SCRAPPER_TOOL_AGENT_PROXY=http://localhost:8888

# =============================================================================
# Proxy pool — the IP-reputation dimension (v1.6.0+)
# =============================================================================
#
# The impersonation ladder rotates TLS fingerprints, but that CANNOT recover a
# burned IP. Observed in practice: a stealth browser that cleared a Radware wall
# cleanly was challenged on the same URL hours later purely because repeated
# automated requests had flagged the egress IP.
#
# Configure a pool and the ladder rotates the proxy alongside the TLS profile on
# every rung, and browser renders get a fresh IP too. Blocked proxies go on a
# cooldown (compounding for repeat offenders) instead of being re-burned.
# Unset = previous behaviour (direct connection / single SCRAPPER_TOOL_AGENT_PROXY).
#
# Residential/mobile proxies are what actually help; datacenter IPs are often
# pre-flagged.
# SCRAPPER_TOOL_PROXIES=http://user:pass@p1:8000,socks5://p2:1080
#
# Or one proxy per line in a file (# comments allowed):
# SCRAPPER_TOOL_PROXY_FILE=/etc/scrapper-tool/proxies.txt

# --- LLM backend -------------------------------------------------------------
# Choices: ollama (default — local, free)
#          openai_compat (any OpenAI-compatible HTTP server)
#          llama_cpp (alias for openai_compat — llama.cpp's `server` mode)
#          vllm (alias for openai_compat — vLLM)
SCRAPPER_TOOL_AGENT_LLM=ollama

# Local model tag. Default = qwen3-vl:8b (vision-language, recommended for
# 16 GB VRAM at Q4_K_M, ~6 GB model + ~1.4 GB vision encoder + KV cache).
#
# Recommendations by hardware (May 2026):
#   qwen3-vl:8b               16 GB VRAM — DEFAULT. Best agentic + UI grounding
#                             at this tier. Q4_K_M ~6.1 GB, Q8_0 fits in 16 GB
#                             for higher OCR accuracy.
#   qwen3-vl:4b               8 GB VRAM — recommended. Q4_K_M ~3.3 GB leaves
#                             headroom for vision encoder + browser process.
#   qwen3-vl:30b              ~20 GB+ VRAM (MoE A3B) — heavier, best quality.
#   qwen3-vl:2b               4-6 GB VRAM — fallback for laptops / low-end GPUs.
#   qwen3-coder:30b           Text-only, top-tier function calling. Vision
#                             auto-disabled. Use for DOM-only flows on 24 GB+.
#   deepseek-v3.2             Heaviest hardware; best general reasoning.
SCRAPPER_TOOL_AGENT_MODEL=qwen3-vl:8b

# Base URL of the local LLM server. Doubles as base URL for openai_compat /
# llama_cpp / vllm backends.
#
# === Common values ===
#   http://localhost:11434                  — local Ollama (default).
#   http://ollama:11434                     — Ollama service inside docker-compose.
#   http://localhost:1234                   — local LM Studio (host).
#   http://host.docker.internal:1234        — LM Studio on host, called
#                                              from inside a Docker container.
#                                              Requires `extra_hosts` in compose.
#   http://localhost:8080                   — local llama.cpp `server` mode.
#   http://localhost:8000                   — local vLLM.
SCRAPPER_TOOL_AGENT_OLLAMA_URL=http://localhost:11434

# ----- LM Studio example (uncomment + set SCRAPPER_TOOL_AGENT_LLM=openai_compat) -----
# LM Studio exposes an OpenAI-compatible API on port 1234 by default.
# 1. Open LM Studio → Local Server tab → Start Server.
# 2. Note the model name shown there (e.g. "qwen3-vl-8b-instruct").
# 3. Then override:
# SCRAPPER_TOOL_AGENT_LLM=openai_compat
# SCRAPPER_TOOL_AGENT_OLLAMA_URL=http://localhost:1234       # or http://host.docker.internal:1234 from Docker
# SCRAPPER_TOOL_AGENT_MODEL=qwen3-vl-8b-instruct

# --- Run budget --------------------------------------------------------------
# E2 (agent_browse) max steps before giving up.
SCRAPPER_TOOL_AGENT_MAX_STEPS=50
# Per-call timeout in seconds (applies to both E1 and E2).
SCRAPPER_TOOL_AGENT_TIMEOUT_S=120

# --- ToS / safety ------------------------------------------------------------
# When 1/true, the agent fetches /robots.txt and refuses if disallowed.
SCRAPPER_TOOL_AGENT_RESPECT_ROBOTS=1

# =============================================================================
# Target URL guard (SSRF protection, v2.2.1+)
# =============================================================================
#
# Every surface vets a URL before issuing a request: private, loopback,
# link-local and cloud-metadata targets are refused, along with non-http(s)
# schemes and hostnames that RESOLVE into private space.
#
# On by default. Leave it that way — a control you have to switch on is not a
# control. To reach a legitimate internal target, allowlist that target rather
# than disabling the guard for everything.
SCRAPPER_TOOL_URL_GUARD=1

# Hostnames, IPs and CIDRs permitted anyway. This is the escape hatch: a local
# fixture server, or an authorised internal scrape. Comma-separated.
#   SCRAPPER_TOOL_URL_GUARD_ALLOW=127.0.0.1,10.0.0.0/8,fixtures.internal
# SCRAPPER_TOOL_URL_GUARD_ALLOW=

# Set 0 to skip the DNS check, vetting only what is visible in the URL itself.
# For air-gapped boxes or a slow resolver. Trade-off: a hostname that points
# into private space is no longer caught.
# SCRAPPER_TOOL_URL_GUARD_DNS=1

# Set 1 to make the curl_cffi ladder follow redirects in Python, vetting every
# hop BEFORE it is issued, instead of handing the chain to libcurl (which has no
# per-hop hook, so a redirect into private space is issued and only the response
# is withheld).
#
# Off by default, but the fingerprint question it was gated on has been measured:
# on the redirected hop itself (the only path that differs), JA4, the peetprint
# hash, the Akamai h2 hash and the h2 header order are all identical with the
# flag on and off. JA3's hash varies in both modes -- that is GREASE, which is
# what real Chrome does. Public 1-hop and 3-hop chains still complete.
#
# Still opt-in because that is one host, one target and one impersonation
# profile: measured once is not soaked. Turning it on is a real security gain --
# with it off, a redirect to 169.254.169.254 IS connected to (three times, once
# per retry) and only the response is withheld.
# SCRAPPER_TOOL_URL_GUARD_STRICT_REDIRECTS=0

# =============================================================================
# CAPTCHA solver cascade
# =============================================================================
#
# The "auto" cascade:
#   Tier 0  Camoufox auto-pass (free, $0)        → most CF Turnstile
#   Tier 1  Theyka/Turnstile-Solver (free, $0)   → CF Turnstile fallback
#   Tier 2  paid solver (only if API key set)    → hCaptcha / reCAPTCHA / etc.
#
# Choices: auto (default — recommended)
#          camoufox-auto (Tier 0 only)
#          theyka (Tier 1 only)
#          capsolver | nopecha | twocaptcha (paid, requires API key)
#          none (raise on captcha)
SCRAPPER_TOOL_CAPTCHA_SOLVER=auto

# Paid-solver API key. Leave unset to keep the cascade free; setting this
# enables Tier 2 escalation. Get one from your chosen vendor's dashboard.
# SCRAPPER_TOOL_CAPTCHA_KEY=sk_capsolver_xxx_replace_me

# Which paid vendor to use when SCRAPPER_TOOL_CAPTCHA_KEY is set.
# Choices: capsolver (default — best 2026 coverage / speed / price)
#          nopecha (free dev tier; smaller coverage)
#          twocaptcha (human-powered fallback; broadest type support)
#          none (don't escalate even if key is present)
SCRAPPER_TOOL_CAPTCHA_PAID_FALLBACK=capsolver

# Per-solve timeout in seconds.
SCRAPPER_TOOL_CAPTCHA_TIMEOUT_S=120

# --- Captcha vision model (v2.2.2+) ------------------------------------------
# Model for the image-grid tier ("click every square with a bus"), which is a
# DIFFERENT job from extraction and wants a different model:
#
#   extraction (SCRAPPER_TOOL_AGENT_MODEL) — page text to strict JSON. Wants
#     instruction-following; a small model wins. A reasoning-distilled model was
#     measured at 8x the latency and *less* accurate.
#   grids (this var) — spatial vision. Measured on live reCAPTCHA:
#     google/gemma-4-e4b 0/5, qwen3-vl-8b 1/5, a ~27B VLM 4-5/5.
#
# Pinning one model for both silently loses at whichever job it wasn't chosen
# for, which is why this is separate. Default since v2.2.2 is a ~27B.
#
# Safe to leave pointing at a model this host cannot serve: the grid tier is
# best-effort, returns an honest False, and the cascade escalates past it.
# `scrapper-tool doctor` reports whether it is actually available.
#
# Set to EMPTY to reuse SCRAPPER_TOOL_AGENT_MODEL instead (correct when one
# model is genuinely good at both, or when you don't want captcha solving).
# Watch the context length: a 27B's 262k default KV cache, not its weights, is
# what overflows a 24 GB card.
SCRAPPER_TOOL_CAPTCHA_VISION_MODEL=qwen3.8-27b-apex

# =============================================================================
# HTTP REST sidecar (scrapper-tool-serve / scrapper-tool-rest)
# =============================================================================
#
# The REST sidecar (v1.1.0+) exposes Patterns A-E over plain JSON/HTTP for
# non-MCP callers. Start it with:
#
#   pip install 'scrapper-tool[http]'
#   scrapper-tool-serve
#
# Or via docker-compose:
#
#   docker compose --profile rest up -d scrapper-tool-rest
#
# See docs/http-sidecar.md for the full reference.

# Bind address. Use 0.0.0.0 inside Docker; 127.0.0.1 to restrict to localhost.
SCRAPPER_TOOL_HTTP_HOST=0.0.0.0

# TCP port. 5792 is the default — uncrowded, avoids 8000/8080 conflicts.
SCRAPPER_TOOL_HTTP_PORT=5792

# Optional. When set, /fetch /scrape /extract /browse require
# `X-API-Key: <value>` header. /health /ready /version /docs /openapi.json
# are always unauthenticated. Leave unset for internal-only sidecar networks.
# SCRAPPER_TOOL_HTTP_API_KEY=your-secret-key

# Comma-separated CORS allowed origins. Use "*" for open access or list
# explicit origins ("https://app.example.com,https://admin.example.com").
#
# NOTE: "*" disables credentialed CORS. The two cannot be combined safely —
# the pinned Starlette reflects the request Origin verbatim and still sends
# allow-credentials: true, which lets any page make credentialed cross-origin
# requests to this sidecar and read the responses. List explicit origins if
# you need credentials.
SCRAPPER_TOOL_HTTP_CORS_ORIGINS=*

# Allow POST /scrape to accept a `cookies` body on an UNAUTHENTICATED sidecar.
#
# By default, sending cookies without SCRAPPER_TOOL_HTTP_API_KEY set is refused
# with 403. /scrape is open out of the box, which is fine for anonymous
# scraping and not fine the moment a request body carries a live session
# cookie: anyone who can reach the port could replay someone's session through
# this host's egress IP.
#
# This is a localhost-development escape hatch. Do not set it on anything
# reachable from another machine — set SCRAPPER_TOOL_HTTP_API_KEY instead.
# SCRAPPER_TOOL_HTTP_ALLOW_UNAUTH_COOKIES=1

# Uvicorn log level: debug | info | warning | error | critical.
SCRAPPER_TOOL_HTTP_LOG_LEVEL=info

# When 0, /docs and /redoc are not served. /openapi.json still works.
# Use 0 in production to reduce attack surface.
SCRAPPER_TOOL_HTTP_DOCS=1

# =============================================================================
# Live integration tests (opt-in)
# =============================================================================

# Enables tests/integration/test_live_probes.py (Patterns A/B/C live probes).
# SCRAPPER_TOOL_LIVE=1

# Enables tests/integration/test_agent_live.py (Pattern E live probes).
# Both must be set together.
# SCRAPPER_TOOL_AGENT=1

# =============================================================================
# Browser-cookie extraction (scrapper-tool cookies)
# =============================================================================

# Where `scrapper-tool cookies export` writes jars. The directory is created
# 0700 and each jar 0600 — treat both as credential stores.
# Extraction itself is HOST-SIDE ONLY: it needs the OS credential store
# (Keychain / DPAPI / gnome-keyring) and a real browser profile, neither of
# which exists in a container. Export on your host, then either pass the jar
# in or bind-mount a seeded profile dir.
# SCRAPPER_TOOL_COOKIE_DIR=~/.scrapper-tool/cookies
